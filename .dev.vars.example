ACCESS_CLIENT_ID=<Copy from "Client ID" in dash>
ACCESS_CLIENT_SECRET=<Copy from "Client secret" in dash>
ACCESS_TOKEN_URL=<Copy from "Token endpoint" in dash>
ACCESS_AUTHORIZATION_URL=<Copy from "Authorization endpoint" in dash>
ACCESS_JWKS_URL=<Copy from "Key endpoint" in dash>
COOKIE_ENCRYPTION_KEY=<generate using, eg, `openssl rand -hex 32`>
TWILIO_ACCOUNT_SID=<Twilio Account SID, AC...>
TWILIO_API_KEY_SID=<Twilio API Key SID, SK...>
TWILIO_API_KEY_SECRET=<Twilio API Key secret, not the account Auth Token>
EXA_API_KEY=<Create at https://dashboard.exa.ai/api-keys>
FANTASYPROS_API_KEY=<Create at https://secure.fantasypros.com/api-keys/request/>
TWILIO_WEBHOOK_KEY_ID=<Twilio SharedKey ID: webhooks_sharedkey_...>
TWILIO_WEBHOOK_KEY_SECRET=<Dedicated Twilio webhook signing secret; configure HMAC_SHA1>
