{
  "name": "concierge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run type-check && npm test && vite build && npm run test:build",
    "deploy": "npm run build && wrangler deploy --config dist/concierge/wrangler.json",
    "dev": "vite",
    "start": "npm run dev",
    "preview": "vite preview",
    "test": "node --test tests/worker.test.mjs",
    "test:build": "node --test tests/build.test.mjs",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.3",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.0",
    "jose": "6.2.12",
    "oauth4webapi": "3.8.8",
    "zod": "^4.4.3"
  },
  "overrides": {
    "agents@0.28.0": {
      "@modelcontextprotocol/client": "$@modelcontextprotocol/client",
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "@modelcontextprotocol/server": "$@modelcontextprotocol/server"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@types/node": "^26.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
