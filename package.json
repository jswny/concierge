{
  "name": "concierge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run type-check && npm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --var CONCIERGE_DEBUG:true",
    "start": "wrangler dev --var CONCIERGE_DEBUG:true",
    "test": "node --test tests/worker.test.mjs",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.1",
    "@cloudflare/workers-oauth-provider": "0.9.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "7.0.2",
    "wrangler": "4.118.0"
  }
}
